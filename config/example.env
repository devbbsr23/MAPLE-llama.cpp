# Example environment for MAPLE. Copy to maple.env (git-ignored). Contains no secrets; never put tokens here.
# restore_kaggle.py writes a maple.env for you on Kaggle.

# MAPLE project directory (default: the directory containing src/)
#MAPLE_HOME=/kaggle/working/MAPLE-llama.cpp

# Restored llama.cpp binaries (default: $MAPLE_HOME/vendor/llamacpp/llama.cpp/build/bin)
#MAPLE_LLAMA_BIN=/kaggle/working/MAPLE-llama.cpp/vendor/llamacpp/llama.cpp/build/bin

# Per-process library path: real NVIDIA driver directory first, then the restored build (MAPLE sets this for its children anyway)
#LD_LIBRARY_PATH=/usr/local/nvidia/lib64:$MAPLE_LLAMA_BIN

# Your own model files (one per roster ID). Defaults are the /kaggle/working/models/... paths in config/models.yaml
#MAPLE_MODEL_DEEPSEEK=/path/to/your-deepseek.gguf
#MAPLE_MODEL_GEMMA=/path/to/your-gemma.gguf
#MAPLE_MODEL_QWEN3=/path/to/your-qwen3.gguf
#MAPLE_MODEL_FAST=/path/to/your-fast.gguf

# Set to 0 when using files other than the validated ones (skips the size check against manifests/models_manifest.json)
#MAPLE_STRICT_MANIFEST=0

# Live GPU tests (only on a host with the models and the restored build)
#MAPLE_LIVE=1
